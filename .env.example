# ==============================================================================
# TenderPulse AI — API environment template (copy to .env)
# The AI worker also reads this file, after apps/ai/.env (values there win).
# Setup guide: docs/DEVELOPMENT.md. No real secrets belong in this file.
# ==============================================================================

# Application
NODE_ENV=development
ENVIRONMENT=development
PORT=3000
# Web origin allowed by CORS in production
APP_BASE_URL=http://localhost:5173

# Security secrets (generate with: openssl rand -hex 32). Local-only placeholders.
JWT_SECRET=super-secret-jwt-key-for-local-dev-only-min-32-chars
INTERNAL_SERVICE_KEY=tenderpulse-internal-secret-2026
BCRYPT_HASH=""
# JWT_ACCESS_TTL_SECONDS=3600
# JWT_REFRESH_TTL_SECONDS=604800

# PostgreSQL 16 (local server or RDS). Required: the API refuses to start without it.
# Local setup: docs/DEVELOPMENT.md §3.
DATABASE_URL=postgresql://tenderpulse:tenderpulse_dev_password@localhost:5432/tenderpulse_db
# TLS: disable (local) | require | verify-full (RDS, with DATABASE_SSL_CA_FILE=<RDS CA bundle>)
# DATABASE_SSL=disable
# DATABASE_POOL_MAX=10
# Load demo users, a company profile and bids into an empty database
SEED_DEMO_DATA=true

# AI worker (FastAPI)
AI_ENGINE_URL=http://localhost:8000
# AI_EXTRACTION_TIMEOUT_MS=
# AI_DECISION_TIMEOUT_MS=

# ------------------------------------------------------------------------------
# Queues (docs/DEVELOPMENT.md §4). Extraction only runs over real queues shared
# with the worker; QUEUE_PROVIDER=mock keeps everything in memory and the worker
# never receives a job.
# ------------------------------------------------------------------------------
# QUEUE_PROVIDER=mock
AWS_REGION=ap-south-1
AWS_SQS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-dociq
AWS_SQS_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-docidlq
AWS_SQS_COMPLETION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-compq
AWS_SQS_COMPLETION_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-compdlq
# Set to false to run the API without the outbox publisher and completion consumer
# DOCUMENT_PROCESSING_CONSUMER_ENABLED=true
# LocalStack instead of AWS
# SQS_ENDPOINT=http://localhost:4566

# ------------------------------------------------------------------------------
# Object storage. With a bucket set, uploads go to S3 and large completion events
# are claim-checked there (the worker must use the same bucket: AWS_S3_BUCKET in
# apps/ai/.env). Without one the API uses in-memory mock storage, and completions
# over 200 KB cannot be claim-checked.
# ------------------------------------------------------------------------------
AWS_S3_BUCKET=<your-dev-bucket>
# STORAGE_PROVIDER=mock
# S3_ENDPOINT=http://localhost:4566

# AWS credentials: leave unset to use your AWS CLI profile (~/.aws). Never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# GCP alternative to SQS/S3 (docs/DEPLOYMENT.md §4)
# GCP_PROJECT_ID=
# GCP_PUBSUB_TOPIC=
# GCP_PUBSUB_SUBSCRIPTION=
# GCP_PUBSUB_DLQ_TOPIC=
# GCP_PUBSUB_COMPLETION_TOPIC=
# GCP_PUBSUB_COMPLETION_SUBSCRIPTION=
# GCP_PUBSUB_COMPLETION_DLQ_TOPIC=
# GCS_BUCKET_NAME=
# GOOGLE_APPLICATION_CREDENTIALS=

# Logging (console + rotated files under logs/)
# LOG_LEVEL=info
# LOG_DIR=logs
# LOG_TO_FILE=true

# ==============================================================================
# Company Evidence & Third-Party Verification Layer (Hexagonal Ports & Adapters)
# ==============================================================================
# GSTIN Taxpayer Verification (set to 'mock' for local dev, or 'iris' for live IRIS IRP)
GST_VERIFICATION_PROVIDER=mock
IRIS_IRP_BASE_URL=https://api.irisirp.com
IRIS_CLIENT_ID=your_iris_client_id
IRIS_CLIENT_SECRET=your_iris_client_secret
IRIS_API_KEY=your_iris_api_key
IRIS_TIMEOUT_MS=10000

# MCA Master Data Verification (set to 'mock' for local dev, or 'mca' for live MCA API)
MCA_REGISTRY_PROVIDER=mock
MCA_API_BASE_URL=https://api.mca.gov.in/v1
MCA_API_KEY=your_mca_api_key
MCA_TIMEOUT_MS=10000

# MSME Udyam Registration (set to 'mock' for local dev, or 'udyam' for live Udyam API)
MSME_VERIFICATION_PROVIDER=mock
UDYAM_API_BASE_URL=https://udyamregistration.gov.in/api/v1
UDYAM_CLIENT_ID=your_udyam_client_id
UDYAM_API_KEY=your_udyam_api_key
UDYAM_TIMEOUT_MS=10000

# DigiLocker Digital Document Depository (set to 'mock' for local dev, or 'digilocker' for live)
DIGILOCKER_PROVIDER=mock
DIGILOCKER_AUTH_URL=https://digilocker.meripehchan.gov.in/public/oauth2/1/authorize
DIGILOCKER_TOKEN_URL=https://digilocker.meripehchan.gov.in/public/oauth2/1/token
DIGILOCKER_API_URL=https://digilocker.meripehchan.gov.in/public/oauth2/1
DIGILOCKER_CLIENT_ID=tenderpulse_dev_client
DIGILOCKER_CLIENT_SECRET=tenderpulse_dev_secret
DIGILOCKER_STATE_SECRET=tenderpulse-state-secret-2026-min-32-chars
DIGILOCKER_TIMEOUT_MS=15000

# Cloud Drive Connectors (Google Drive API & Microsoft Graph OneDrive / SharePoint)
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
MICROSOFT_GRAPH_CLIENT_ID=your_microsoft_graph_client_id
MICROSOFT_GRAPH_CLIENT_SECRET=your_microsoft_graph_client_secret
