# ==============================================================================
# TenderPulse AI Service — Environment Template (apps/ai/.env.example)
# ==============================================================================

# Service Identification & Environment
SERVICE_NAME=tenderpulse-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

# Internal Service-to-Service Authentication (Shared Secret with NestJS Gateway)
INTERNAL_SERVICE_KEY=tenderpulse-internal-secret-2026

# NestJS API Gateway Base URL
API_GATEWAY_URL=http://localhost:3000

# ==============================================================================
# LLM Gateway Settings (OpenRouter / OpenAI-Compatible)
# ==============================================================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=google/gemini-2.0-flash-001
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2

# Extraction is LLM-only (no rule fallback). off | record | replay:
#   record saves raw responses to tests/fixtures/llm_cassettes, replay serves them offline.
LLM_REPLAY_MODE=off
# Output token budget for structured extraction (reasoning is disabled for extraction calls)
LLM_MAX_TOKENS=4096
# Tesseract language packs for scanned (image-only) pages, e.g. eng+hin
OCR_LANGUAGES=eng

# ==============================================================================
# Two-Queue Event Choreography (Option B: Decoupled Cloud Architecture)
# ==============================================================================
# Ingestion Queue Provider: "sqs" (AWS SQS), "pubsub" (GCP), "mock" (in-memory), "none" (HTTP only)
INGESTION_QUEUE_PROVIDER=none

# Ingestion Queue URL / Subscription (Python worker consumes jobs from here)
AWS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/tenderai-ingestion-queue
# GCP_INGESTION_SUBSCRIPTION=projects/your-gcp-project/subscriptions/tenderpulse-worker-sub

# Ingestion Worker Polling & Heartbeat Parameters
QUEUE_POLL_INTERVAL_SECONDS=1.0
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_HEARTBEAT_INTERVAL_SECONDS=60

# Completion Queue Provider: "sqs" (AWS SQS), "pubsub" (GCP), "mock" (in-memory)
COMPLETION_QUEUE_PROVIDER=mock

# Completion Queue URL / Topic (Python worker publishes extraction completed events here)
AWS_COMPLETION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/123456789012/tenderai-completion-queue
# GCP_COMPLETION_TOPIC=projects/your-gcp-project/topics/tenderpulse-extraction-completed

# ==============================================================================
# Cloud Infrastructure Credentials (AWS S3 & SQS Access for boto3)
# ==============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name
