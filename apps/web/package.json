{
  "name": "@tenderpulse/web",
  "version": "1.0.0",
  "private": true,
  "description": "TenderPulse AI Web Frontend (React 18 + Vite)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
