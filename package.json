{
  "name": "tenderpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "npm run dev -w @tenderpulse/api",
    "dev:web": "npm run dev -w @tenderpulse/web",
    "build": "npm run build --workspaces --if-present",
    "type-check": "npm run type-check --workspaces --if-present",
    "test": "vitest run tests/ && npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write '**/*.{ts,tsx,json,md,yml}'",
    "format:check": "prettier --check '**/*.{ts,tsx,json,md}'"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
