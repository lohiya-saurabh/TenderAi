{
  "name": "tenderpulse-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:api": "npm run dev -w @tenderpulse/api",
    "dev:web": "npm run dev -w @tenderpulse/web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @tenderpulse/shared-types && npm run build -w @tenderpulse/ui",
    "type-check": "npm run build:shared && npm run type-check --workspaces --if-present",
    "test": "vitest run tests/ && npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:wipe": "node --env-file-if-exists=.env scripts/wipe-data.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed-data.js",
    "db:status": "node --env-file-if-exists=.env scripts/db-status.js",
    "db:query": "node --env-file-if-exists=.env scripts/db-query.js",
    "prepare": "bash scripts/install-git-hooks.sh || true",
    "precommit": "bash .githooks/pre-commit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "playwright": "^1.63.0",
    "prettier": "^3.5.2",
    "typescript": "^5.8.2",
    "vitest": "^5.0.3"
  }
}
