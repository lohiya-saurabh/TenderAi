# ==============================================================================
# TenderPulse AI Environment Configuration Template
# Copy to .env for local development
# ==============================================================================

# Application Environment
NODE_ENV=development
ENVIRONMENT=development
PORT=3000

# Security Secrets (Generate using openssl rand -hex 32)
JWT_SECRET=super-secret-jwt-key-for-local-dev-only-min-32-chars
INTERNAL_SERVICE_KEY=tenderpulse-internal-secret-2026

# PostgreSQL Database (Aurora / RDS / Local)
DATABASE_URL=postgresql://tenderpulse:tenderpulse_dev_password@localhost:5432/tenderpulse_db?schema=public

# AWS Configuration (Local development uses LocalStack or mock endpoints)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_ENDPOINT=http://localhost:4566
S3_BUCKET_NAME=tenderpulse-development-vault
SQS_ENDPOINT=http://localhost:4566
SQS_INGESTION_QUEUE_URL=http://localhost:4566/000000000000/tenderpulse-development-ingestion

# AI Engine (Python FastAPI Worker)
AI_SERVICE_URL=http://localhost:8000
LLM_PROVIDER=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
