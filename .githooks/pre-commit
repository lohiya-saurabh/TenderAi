#!/usr/bin/env bash
# ==============================================================================
# TenderPulse AI - Git Pre-Commit Quality Gate
# Enforces TypeScript ESLint, Type Checking, and Python Ruff before every commit.
# ==============================================================================
set -euo pipefail

# ANSI Color Codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m' # No Color

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo -e "${BLUE}${BOLD}================================================================${NC}"
echo -e "${BLUE}${BOLD}🛡️  TenderPulse AI Pre-Commit Quality Enforcement Gate${NC}"
echo -e "${BLUE}${BOLD}================================================================${NC}"

# Check for staged changes
if git diff --cached --quiet; then
  echo -e "${YELLOW}ℹ️  No staged changes detected. Skipping checks.${NC}"
  exit 0
fi

# 1. Secret Detection & Credential Leak Gate
echo -e "\n${BOLD}[1/4] 🔐 Scanning staged changes for hardcoded secrets & credentials...${NC}"
if command -v gitleaks &>/dev/null; then
  if ! gitleaks protect --staged -v; then
    echo -e "\n${RED}❌ FAILED: Gitleaks detected sensitive credentials in staged changes!${NC}"
    echo -e "${RED}Do not commit raw secrets. Store them in .env and access via process.env.${NC}"
    exit 1
  fi
  echo -e "${GREEN}✅ Gitleaks secret scan passed cleanly.${NC}"
else
  STAGED_SECRETS=$(git diff --cached -U0 -- ':(exclude)*.env*' ':(exclude)*.example*' ':(exclude)*.md' ':(exclude)*.spec.*' ':(exclude)*.test.*' ':(exclude)*vitest.config.*' | grep -E '^\+[^+].*(JWT_SECRET\s*[:=]\s*["'\''][^"'\'']{8,}["'\'']|INTERNAL_SERVICE_KEY\s*[:=]\s*["'\''][^"'\'']{8,}["'\'']|BEGIN (RSA|EC|DSA|OPENSSH)? PRIVATE KEY|AKIA[0-9A-Z]{16})' || true)
  if [ -n "$STAGED_SECRETS" ]; then
    echo -e "\n${RED}❌ FAILED: Potential hardcoded secret detected in staged changes:${NC}"
    echo -e "${YELLOW}$STAGED_SECRETS${NC}"
    echo -e "${RED}Never hardcode secrets inside source code! Store them in .env and reference via process.env.${NC}"
    exit 1
  fi
  echo -e "${GREEN}✅ Secret pattern scan passed (0 credentials detected).${NC}"
fi

# 2. ESLint across all workspaces
echo -e "\n${BOLD}[2/4] 🔍 Running ESLint across all workspaces (--max-warnings=0)...${NC}"
if ! npm run lint; then
  echo -e "\n${RED}❌ FAILED: ESLint reported errors or warnings!${NC}"
  echo -e "${RED}Fix all ESLint errors/warnings above before committing.${NC}"
  exit 1
fi
echo -e "${GREEN}✅ ESLint passed cleanly (0 errors, 0 warnings).${NC}"

# 3. TypeScript type-check across monorepo
echo -e "\n${BOLD}[3/4] 📐 Running TypeScript type-checking (tsc --noEmit)...${NC}"
if ! npm run type-check; then
  echo -e "\n${RED}❌ FAILED: TypeScript compilation errors found!${NC}"
  echo -e "${RED}Fix all TypeScript type errors above before committing.${NC}"
  exit 1
fi
echo -e "${GREEN}✅ TypeScript type-checking passed cleanly.${NC}"

# 4. Python AI Engine Lint & Format check (Ruff)
echo -e "\n${BOLD}[4/4] 🐍 Checking Python AI Engine (Ruff lint & format)...${NC}"
# Only the ruff pinned in apps/ai/uv.lock: other versions format differently.
RUFF_CMD=""
if [ -x "$REPO_ROOT/apps/ai/.venv/bin/ruff" ]; then
  RUFF_CMD="$REPO_ROOT/apps/ai/.venv/bin/ruff"
elif command -v uv &>/dev/null; then
  RUFF_CMD="uv run --directory apps/ai --extra dev ruff"
fi

if [ -n "$RUFF_CMD" ]; then
  if ! (cd "$REPO_ROOT/apps/ai" && $RUFF_CMD check . && $RUFF_CMD format --check .); then
    echo -e "\n${RED}❌ FAILED: Python Ruff linting or formatting check failed!${NC}"
    echo -e "${YELLOW}Run: cd apps/ai && ruff check --fix . && ruff format .${NC}"
    exit 1
  fi
  echo -e "${GREEN}✅ Python Ruff checks passed cleanly.${NC}"
else
  # Check if Python files are staged
  if git diff --cached --name-only | grep -E '^apps/ai/.*\.py$' >/dev/null 2>&1; then
    echo -e "\n${RED}❌ FAILED: Python files are staged, but 'ruff' executable was not found.${NC}"
    echo -e "${YELLOW}Run: cd apps/ai && uv sync --extra dev${NC}"
    exit 1
  else
    echo -e "${YELLOW}⚠️  Ruff not found in environment, but no Python files staged. Skipping.${NC}"
  fi
fi

echo -e "\n${GREEN}${BOLD}================================================================${NC}"
echo -e "${GREEN}${BOLD}✅ All pre-commit quality checks passed! Proceeding with commit.${NC}"
echo -e "${GREEN}${BOLD}================================================================${NC}\n"
exit 0
