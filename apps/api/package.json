{
  "name": "@tenderpulse/api",
  "version": "1.0.0",
  "private": true,
  "description": "TenderPulse AI Application API Service",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint 'src/**/*.ts' --max-warnings=0",
    "dev": "tsc && node dist/main.js",
    "start": "node dist/main.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/client-sqs": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@electric-sql/pglite": "^0.5.8",
    "@google-cloud/pubsub": "^6.1.0",
    "@google-cloud/storage": "^8.2.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@tenderpulse/shared-types": "*",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@tenderpulse/config": "*",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.9",
    "@types/pdf-parse": "^1.1.5",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
