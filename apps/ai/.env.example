# ==============================================================================
# TenderPulse AI worker — environment template (copy to apps/ai/.env)
# The worker reads this file first, then the root .env for anything not set here.
# Setup guide: docs/DEVELOPMENT.md. No real secrets belong in this file.
# ==============================================================================

# Service
SERVICE_NAME=tenderpulse-ai
ENVIRONMENT=development
LOG_LEVEL=INFO

# Shared secret with the API (must match INTERNAL_SERVICE_KEY in the root .env)
INTERNAL_SERVICE_KEY=tenderpulse-internal-secret-2026
API_GATEWAY_URL=http://localhost:3000

# ==============================================================================
# LLM providers (docs/AI_PIPELINE.md §3). "rotation" uses every provider whose key
# is set, in order: Cerebras, Groq, Gemini, SambaNova, OpenRouter.
# ==============================================================================
LLM_PROVIDER=rotation
CEREBRAS_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
SAMBANOVA_API_KEY=
# OpenRouter is disabled locally; uncomment to add it at the end of the rotation.
# OPENROUTER_API_KEY=

# Single OpenAI-compatible endpoint for tender chat (without LLM_API_KEY, chat skips the model)
# LLM_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/free

# Extraction tuning (defaults shown)
LLM_TIMEOUT_SECONDS=45.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4096
# Page windows extracted in parallel, and pages per window (capped at 3)
LLM_MAX_CONCURRENCY=8
BATCH_PAGE_WINDOW_SIZE=3
# When every provider is rate-limited, how long one call may wait for one to free up
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=180
# off | record | replay: record saves raw responses to tests/fixtures/llm_cassettes,
# replay serves them offline (a missing recording is an error)
LLM_REPLAY_MODE=off
# Tesseract language packs for scanned (image-only) pages, e.g. eng+hin
OCR_LANGUAGES=eng

# Dense retrieval: local ONNX embedding model (fastembed), downloaded on first use (~67 MB).
# EMBEDDING_PROVIDER=none runs BM25 only. Vectors from another model are ignored, never mixed.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=./data/fastembed

# ==============================================================================
# Queues (docs/DEVELOPMENT.md §4): the worker consumes the ingestion queue and
# publishes to the completion queue. Use the same dev queues as the API.
# ==============================================================================
# sqs | pubsub | mock | none (none = HTTP endpoints only, no consumer)
INGESTION_QUEUE_PROVIDER=sqs
AWS_INGESTION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-dociq
# GCP_INGESTION_SUBSCRIPTION=projects/<project>/subscriptions/<subscription>
QUEUE_POLL_INTERVAL_SECONDS=1.0
QUEUE_VISIBILITY_TIMEOUT_SECONDS=300
QUEUE_HEARTBEAT_INTERVAL_SECONDS=60

# sqs | pubsub | http (POST to the API's /api/v1/internal/extraction-completed) | mock
COMPLETION_QUEUE_PROVIDER=sqs
AWS_SQS_COMPLETION_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-compq
AWS_SQS_COMPLETION_DLQ_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/tenderai-dev-compdlq
# GCP_COMPLETION_TOPIC=projects/<project>/topics/<topic>

# ==============================================================================
# AWS. Completion events over 200 KB are claim-checked to this bucket, which must
# be the bucket the API uses (AWS_S3_BUCKET in the root .env).
# ==============================================================================
AWS_REGION=ap-south-1
AWS_S3_BUCKET=<your-dev-bucket>
# Leave unset to use your AWS CLI profile (~/.aws). Never commit real keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
